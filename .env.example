# Copy to .env and fill in. Never commit .env.

# --- messaging ---
KAFKA_BOOTSTRAP=redpanda:9092
SCHEMA_REGISTRY_URL=http://redpanda:8081

# --- postgres (per-role URLs are composed in docker-compose.yml from this one password) ---
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=15432       # host-side port for psql / tooling; services use the compose network

# --- llm (provider-agnostic; see ADR-006) ---
LLM_PROVIDER=openai            # openai | anthropic | ollama
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MODE=replay                # live | replay | record
CASSETTE_DIR=/workspace/eval/cassettes

# --- auth ---
JWT_SECRET=dev-only-change-me
JWT_ISSUER=qgate-agent

# --- foreign plant system ---
MES_BASE_URL=http://mock-mes:8003
MES_API_KEY=dev-mes-key
MES_CHAOS=0

# --- internal service urls ---
DETECT_BASE_URL=http://detect:8002
API_BASE_URL=http://api:8000
AGENT_BASE_URL=http://agent:8001

# --- gate ---
APPROVAL_TIMEOUT_S=1800

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO

# --- line-sim ---
SCENARIO=clean_baseline
REPLAY_SPEED=10
SEED=42

# --- console ---
VITE_API_BASE_URL=http://localhost:8000
